t; = service Java (Spring Boot) · khung nét đứt xám = thành phần chưa xác nhận đầy đủ. Dòng chữ đỏ trong card = DB / cache / queue mà service dùng (chi tiết: tài liệu thiết kế §3.1.2). Mũi tên từ mép tầng = phụ thuộc chung của các service trong tầng (danh sách ghi trên nhãn hoặc trong ô đích, sau dấu ←). CyberHSM (xbill-signing-service) thuộc hệ sinh thái CyberLotus, kết nối qua Kafka — không vẽ lại trong xBill." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="14" y="1088" width="2210" height="48" as="geometry" /></mxCell><mxCell id="lg_net" value="&lt;b&gt;.NET&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.6;fontSize=11;spacing=4;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#3C6EB4;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="110" height="40" as="geometry" /></mxCell><mxCell id="lg_java" value="&lt;b&gt;Java&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.6;fontSize=11;spacing=4;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#C77700;" vertex="1" parent="1"><mxGeometry x="150" y="1150" width="110" height="40" as="geometry" /></mxCell><mxCell id="lga0" value="" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="300" y="1168" width="2" height="4" as="geometry" /></mxCell><mxCell id="lgb0" value="" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="360" y="1168" width="2" height="4" as="geometry" /></mxCell><mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F4E79;strokeWidth=1.8;fontColor=#1F4E79;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="lga0" target="lgb0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgt0" value="HTTP / HTTPS / gRPC" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;fontSize=11;align=left;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="370" y="1158" width="240" height="24" as="geometry" /></mxCell><mxCell id="lga1" value="" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="620" y="1168" width="2" height="4" as="geometry" /></mxCell><mxCell id="lgb1" value="" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="680" y="1168" width="2" height="4" as="geometry" /></mxCell><mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C55A11;strokeWidth=1.8;fontColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="lga1" target="lgb1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgt1" value="RabbitMQ (AMQP :5672)" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;fontSize=11;align=left;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="690" y="1158" width="240" height="24" as="geometry" /></mxCell><mxCell id="lga2" value="" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="940" y="1168" width="2" height="4" as="geometry" /></mxCell><mxCell id="lgb2" value="" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1000" y="1168" width="2" height="4" as="geometry" /></mxCell><mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B1FA2;strokeWidth=1.8;fontColor=#7B1FA2;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="lga2" target="lgb2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgt2" value="Kafka (:9092 / SASL :9093)" style=