<mxfile host="app.diagrams.net" agent="BillCloud-gen" version="24.0.0"><diagram id="billcloud-arch" name="Kiến trúc tổng thể"><mxGraphModel dx="2800" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2960" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;KIẾN TRÚC TỔNG THỂ xCyberBill Cloud (BillCloud)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Phân tầng: Người dùng → Internet / VPN → Giao diện → Proxy / API Gateway → Backend tầng 1 (public) → Backend tầng 2 (nội bộ) → Dữ liệu · cập nhật 2026-10-09 (rev 3) · host/port theo cấu hình DEV/DEMO — PROD cần đối chiếu&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="0" y="-80" width="2240" height="66" as="geometry" /></mxCell><mxCell id="L0" value="" style="swimlane;horizontal=1;startSize=30;html=1;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;rounded=0;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2240" height="130" as="geometry" /></mxCell><mxCell id="L1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="0" y="145" width="2240" height="56" as="geometry" /></mxCell><mxCell id="L1t" value="&lt;b&gt;INTERNET / VPN&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#37474F;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1030" y="159" width="220" height="28" as="geometry" /></mxCell><mxCell id="L1d" value="HTTPS 443 qua Internet: người dùng, app mobile, ERP/POS · VPN / kênh riêng: đối tác, hệ thống nội bộ CyberLotus · tầng backend không mở trực tiếp ra ngoài" style="text;html=1;fillColor=none;stroke